// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "context_servers": {
    "some-remote-server": {
      "enabled": true,
      "url": "https://example.com/mcp"
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "preview_tabs": {
    "enabled": false
  },
  "terminal": {
    "font_size": 12.0,
    "font_family": "MesloLGS Nerd Font Mono"
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "buffer_font_fallbacks": [
    "Courier New",
    "monospace"
  ],
  "buffer_font_family": "MesloLGS Nerd Font Mono",
  "file_types": {
    "plaintext": [
      "*.cer"
    ],
    "javascript": [
      "*.js"
    ],
    "yaml": [
      "*.yml",
      "*.yml"
    ],
    "azure-pipelines": [
      "pipeline.yaml",
      "yaml/pipelinevariables.yml",
      "pipeline.yaml",
      "yaml/pipelinevariables.yml"
    ],
    "html": [
      "*.svg",
      "*.svg"
    ],
    "gotmpl": [
      "*.tmpl",
      "*.tmpl"
    ]
  },
  "colorize_brackets": true,
  "tab_size": 4,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "effort": "high",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha (Blur) [Light]",
  },
  "format_on_save": "on"
}
